    "praise": {
      "Package": "praise",
      "Version": "1.0.0",
      "Source": "GitHub",
      "Title": "Praise Users",
      "Author": "Gabor Csardi, Sindre Sorhus",
      "Maintainer": "Gabor Csardi <csardi.gabor@gmail.com>",
      "Description": "Build friendly R packages that praise their users if they have done something good, or they just need it to feel better.",
      "License": "MIT + file LICENSE",
      "LazyData": "true",
      "URL": "https://github.com/rladies/praise",
      "BugReports": "https://github.com/rladies/praise/issues",
      "Suggests": [
        "testthat"
      ],
      "Collate": "'adjective.R' 'adverb.R' 'exclamation.R' 'verb.R' 'smiley.R' 'rpackage.R' 'package.R'",
      "RoxygenNote": "5.0.1.9000",
      "RemoteType": "github",
